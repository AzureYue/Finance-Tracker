rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test collection
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId) && isValidId(transactionId);
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId) && isValidId(categoryId);
      }

      // Savings Jars subcollection
      match /savingsJars/{jarId} {
        allow read, write: if isOwner(userId) && isValidId(jarId);
      }

      // Budget Config subcollection
      match /config/{configId} {
        allow read, write: if isOwner(userId) && isValidId(configId);
      }
    }
  }
}
